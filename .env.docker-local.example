# Copy this file to .env.docker-local and replace the placeholder values.
POSTGRES_USER=cetfind
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=cetfind
DATABASE_URL=postgresql+psycopg2://cetfind:replace-with-a-local-password@db:5432/cetfind
CET_ADMIN_SESSION_SECRET=replace-with-a-long-random-local-secret
